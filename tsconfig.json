    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2021"
  },
  "include": [
    "src/platform/domain.js",
    "src/platform/fixtures.js"
  ]
}
