VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PLATFORM_MOCK_MODE=true
VITE_TURNSTILE_SITE_KEY=
# Local mock development only. Never configure this value in a deployed environment.
VITE_ADMIN_PASSWORD=change-this-local-test-password

# Cloudflare Pages Function secrets for the Messenger intent webhook.
# Never prefix these with VITE_ and never commit real values.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
# Keep false while Meta Business Suite sends the first-message welcome.
FACEBOOK_WEBHOOK_SEND_WELCOME=false
